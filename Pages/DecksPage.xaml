<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:vm="clr-namespace:AetherVault.ViewModels"
             xmlns:models="clr-namespace:AetherVault.Models"
             xmlns:controls="clr-namespace:AetherVault.Controls"
             xmlns:constants="clr-namespace:AetherVault.Constants"
             x:Class="AetherVault.Pages.DecksPage"
             Title="Decks"
             BackgroundColor="{StaticResource Background}"
             x:DataType="vm:DecksViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header: title, status, layout toggle -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Margin="16,12,16,8"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="My Decks"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           HeightRequest="16"
                                           WidthRequest="16"
                                           Color="{StaticResource Accent}" />
                        <Label Text="{Binding StatusDisplayText}"
                               FontSize="13"
                               TextColor="{Binding StatusTextColor}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="4"
                                       VerticalOptions="Center">
                    <Button Command="{Binding SelectDeckHubLayoutListCommand}"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            CornerRadius="10"
                            FontFamily="FASolid"
                            FontSize="16"
                            Text="{x:Static fa:Solid.List}"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="{StaticResource CardBackground}"
                            SemanticProperties.Description="List layout">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsDeckHubLayoutList}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="Black" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Command="{Binding SelectDeckHubLayoutTilesCommand}"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            CornerRadius="10"
                            FontFamily="FASolid"
                            FontSize="16"
                            Text="{x:Static fa:Solid.TableCells}"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="{StaticResource CardBackground}"
                            SemanticProperties.Description="Tile layout">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsDeckHubLayoutTiles}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="Black" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Primary CTA + deck tools -->
        <VerticalStackLayout Grid.Row="1"
                             Margin="16,0,16,8"
                             Spacing="8">
            <Button Clicked="OnNewDeckClicked"
                    Text="New deck"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="Black"
                    FontSize="17"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"
                    HorizontalOptions="Fill"
                    BorderWidth="0">
                <Button.ImageSource>
                    <FontImageSource FontFamily="FASolid"
                                     Glyph="{x:Static fa:Solid.Plus}"
                                     Size="18"
                                     Color="Black" />
                </Button.ImageSource>
            </Button>
            <Button Clicked="OnDeckToolsClicked"
                    Text="Deck tools"
                    BackgroundColor="{StaticResource Surface}"
                    TextColor="{StaticResource TextPrimary}"
                    FontSize="14"
                    CornerRadius="12"
                    HeightRequest="44"
                    HorizontalOptions="Fill"
                    BorderWidth="0"
                    SemanticProperties.Hint="Import, export, or browse sample decks" />
        </VerticalStackLayout>

        <!-- Content area -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource Background}">

            <!-- List layout -->
            <CollectionView ItemsSource="{Binding Decks}"
                            IsVisible="{Binding IsDeckHubListVisible}"
                            SelectionMode="Single"
                            SelectionChanged="OnDeckSelectionChanged"
                            Margin="12,0,12,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DeckEntity">
                        <controls:DeckListItem OverflowMenuRequested="OnDeckListOverflowMenuRequested" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Tile layout -->
            <CollectionView ItemsSource="{Binding Decks}"
                            IsVisible="{Binding IsDeckHubTilesVisible}"
                            SelectionMode="Single"
                            SelectionChanged="OnDeckSelectionChanged"
                            Margin="12,0,12,8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DeckEntity">
                        <controls:DeckHubTileView Padding="0"
                                                  StrokeShape="RoundRectangle 14"
                                                  Stroke="{StaticResource CardBackground}"
                                                  StrokeThickness="1"
                                                  BackgroundColor="{StaticResource Surface}">
                            <Grid>
                                <Grid IsVisible="{Binding HasPreviewImage}"
                                      BackgroundColor="{StaticResource CardBackground}">
                                    <controls:CachedCardImage CardUuid="{Binding PreviewImageId}"
                                                               ImageSize="art_crop"
                                                               InputTransparent="True"
                                                               HorizontalOptions="Fill"
                                                               VerticalOptions="Fill" />
                                </Grid>
                                <Grid IsVisible="{Binding HasPreviewImage, Converter={StaticResource InvertedBool}}">
                                    <Border BackgroundColor="#2C2C36"
                                            StrokeThickness="0" />
                                    <Label FontFamily="FASolid"
                                           Text="{x:Static fa:Solid.LayerGroup}"
                                           FontSize="36"
                                           TextColor="#555560"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           InputTransparent="True" />
                                </Grid>
                                <Border InputTransparent="True"
                                        StrokeThickness="0"
                                        VerticalOptions="Fill"
                                        HorizontalOptions="Fill"
                                        BackgroundColor="#5C000000" />
                                <Grid Padding="10,8"
                                      RowDefinitions="Auto,*,Auto"
                                      RowSpacing="4">
                                    <Grid Grid.Row="0"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="6">
                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2"
                                               TextColor="White"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               VerticalOptions="Start" />
                                        <Button Grid.Column="1"
                                                Clicked="OnDeckTileOverflowClicked"
                                                BackgroundColor="#99000000"
                                                Padding="6"
                                                HeightRequest="36"
                                                WidthRequest="36"
                                                CornerRadius="18"
                                                CommandParameter="{Binding .}"
                                                SemanticProperties.Hint="Deck actions">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="FASolid"
                                                                 Glyph="{x:Static fa:Solid.EllipsisVertical}"
                                                                 Size="14"
                                                                 Color="White" />
                                            </Button.ImageSource>
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Row="2"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8"
                                          VerticalOptions="End">
                                        <Label Grid.Column="0"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FormatDisplay}"
                                                          TextColor="#EEEEEE"
                                                          FontSize="12" />
                                                    <Span Text=" · "
                                                          TextColor="#AAAAAA"
                                                          FontSize="12" />
                                                    <Span Text="{Binding CardCount}"
                                                          TextColor="#CCCCCC"
                                                          FontSize="12" />
                                                    <Span Text=" cards"
                                                          TextColor="#CCCCCC"
                                                          FontSize="12" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <controls:ManaCostView Grid.Column="1"
                                                                ManaText="{Binding ColorIdentityManaText}"
                                                                SymbolSize="16"
                                                                InputTransparent="True"
                                                                VerticalOptions="Center"
                                                                HorizontalOptions="End"
                                                                MaximumWidthRequest="96"
                                                                IsVisible="{Binding HasColorIdentity}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </controls:DeckHubTileView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Empty state -->
            <controls:EmptyStateView IsVisible="{Binding IsEmpty}"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Margin="32"
                                     IconGlyph="{x:Static fa:Solid.LayerGroup}"
                                     Message="No decks yet"
                                     SecondaryMessage="Tap &quot;New deck&quot; above to create your first deck, then add cards from Search or your Collection." />
        </Grid>

    </Grid>

</ContentPage>
