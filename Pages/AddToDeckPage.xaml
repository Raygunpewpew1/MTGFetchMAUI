<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AetherVault.Controls"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="AetherVault.Pages.AddToDeckPage"
             Title="Add to deck"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">

        <!-- Card name (always visible) -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,16"
                Padding="16,14">
            <VerticalStackLayout Spacing="4">
                <Label Text="Adding card"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}" />
                <Label x:Name="TitleLabel"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       LineBreakMode="TailTruncation"
                       MaxLines="2" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalOptions="Fill">
            <VerticalStackLayout Spacing="20">

                <!-- No decks empty state -->
                <Border x:Name="NoDeckPanel"
                        IsVisible="False"
                        Style="{StaticResource CardStyle}"
                        Padding="20,24">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Label Text="You don't have any decks yet."
                               FontSize="15"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Create deck"
                                Clicked="OnCreateDeckClicked"
                                BackgroundColor="{StaticResource Accent}"
                                TextColor="Black"
                                FontAttributes="Bold"
                                HeightRequest="48"
                                CornerRadius="12"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Deck + Section + Quantity (when decks exist) -->
                <VerticalStackLayout x:Name="DeckPickerPanel" Spacing="20">

                    <Border Style="{StaticResource CardStyle}" Padding="16">
                        <material:PickerField x:Name="DeckPicker"
                                              Title="Choose a deck..."
                                              TextColor="{StaticResource TextPrimary}"
                                              TitleColor="{StaticResource TextSecondary}"
                                              AccentColor="{StaticResource Accent}" />
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16">
                        <material:PickerField x:Name="SectionPicker"
                                              Title="Section"
                                              TextColor="{StaticResource TextPrimary}"
                                              TitleColor="{StaticResource TextSecondary}"
                                              AccentColor="{StaticResource Accent}" />
                    </Border>

                    <!-- Quantity -->
                    <Border Style="{StaticResource CardStyle}" Padding="20,16">
                        <VerticalStackLayout Spacing="16">
                            <controls:QuantitySelectorView x:Name="QuantitySelector"
                                                           HeaderText="How many copies?" />
                            <Label Text="Tap the number to enter a custom amount"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center" />
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Button Text="+1"
                                        Clicked="OnQuickAddOneClicked"
                                        HeightRequest="36"
                                        FontSize="14"
                                        WidthRequest="56"
                                        BackgroundColor="{StaticResource Surface}"
                                        TextColor="{StaticResource TextPrimary}"
                                        CornerRadius="8" />
                                <Button Text="+2"
                                        Clicked="OnQuickAddTwoClicked"
                                        HeightRequest="36"
                                        FontSize="14"
                                        WidthRequest="56"
                                        BackgroundColor="{StaticResource Surface}"
                                        TextColor="{StaticResource TextPrimary}"
                                        CornerRadius="8" />
                                <Button Text="+4"
                                        Clicked="OnQuickAddFourClicked"
                                        HeightRequest="36"
                                        FontSize="14"
                                        WidthRequest="56"
                                        BackgroundColor="{StaticResource Surface}"
                                        TextColor="{StaticResource TextPrimary}"
                                        CornerRadius="8" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Actions -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="16"
              Padding="0,16,0,0">
            <Button Text="Cancel"
                    Clicked="OnCancelClicked"
                    HeightRequest="48"
                    FontSize="16"
                    BackgroundColor="{StaticResource Surface}"
                    TextColor="{StaticResource TextPrimary}"
                    CornerRadius="12"
                    StyleClass="OutlinedButton" />
            <Button x:Name="ConfirmButton"
                    Grid.Column="1"
                    Text="Add to Main"
                    Clicked="OnConfirmClicked"
                    HeightRequest="48"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="Black"
                    CornerRadius="12"
                    StyleClass="FilledButton" />
        </Grid>

    </Grid>

</ContentPage>
