<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AetherVault.Controls"
             xmlns:vm="clr-namespace:AetherVault.ViewModels"
             xmlns:views="clr-namespace:AetherVault.Views"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:constants="clr-namespace:AetherVault.Constants"
             x:Class="AetherVault.Pages.DeckDetailPage"
             Title="{Binding Deck.Name}"
             BackgroundColor="{StaticResource Background}"
             x:DataType="vm:DeckDetailViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Undo"
                     Command="{Binding UndoDeckEditCommand}"
                     Order="Primary"
                     Priority="0" />
        <ToolbarItem Text="Select"
                     Command="{Binding ToggleSelectionModeCommand}"
                     Order="Primary"
                     Priority="1" />
        <ToolbarItem Text="More"
                     Clicked="OnDeckDetailMoreClicked"
                     Order="Primary"
                     Priority="2" />
    </ContentPage.ToolbarItems>

    <Grid x:Name="DeckDetailRoot"
          RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Row 0: Build header — commander slot, progress toward target, validation chip. Always visible. -->
        <Border Grid.Row="0"
                Padding="12,10"
                BackgroundColor="{StaticResource Surface}"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12">

                <!-- Commander slot (commander-zone formats only): thumbnail or "choose" placeholder. -->
                <Border Grid.Column="0"
                        WidthRequest="46"
                        HeightRequest="64"
                        StrokeShape="RoundRectangle 6"
                        Stroke="{StaticResource CardBackground}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource CardBackground}"
                        IsVisible="{Binding IsCommanderZoneFormat}"
                        SemanticProperties.Hint="Commander — tap to view, change, or choose">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCommanderSlotTapped" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <controls:CachedCardImage CardUuid="{Binding FirstCommander.ImageId}"
                                                  ImageSize="small"
                                                  InputTransparent="True"
                                                  HorizontalOptions="Fill"
                                                  VerticalOptions="Fill"
                                                  IsVisible="{Binding HasNoCommander, Converter={StaticResource InvertedBool}}" />
                        <Label FontFamily="FASolid"
                               Text="{x:Static fa:Solid.Crown}"
                               FontSize="18"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True"
                               IsVisible="{Binding HasNoCommander}" />
                    </Grid>
                </Border>

                <!-- Progress -->
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="5"
                                     VerticalOptions="Center">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Grid.Column="0"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding DeckFormat}"
                                          FontSize="12"
                                          TextColor="{StaticResource TextSecondary}" />
                                    <Span Text="  " />
                                    <Span Text="{Binding DeckProgressText}"
                                          FontSize="15"
                                          FontAttributes="Bold"
                                          TextColor="{StaticResource TextPrimary}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Grid.Column="1"
                               Text="{Binding DeckPriceSummaryDisplay}"
                               FontSize="11"
                               TextColor="{StaticResource Accent}"
                               VerticalOptions="Center"
                               IsVisible="{Binding ShowDeckPrices}" />
                    </Grid>
                    <ProgressBar Progress="{Binding DeckProgressFraction}"
                                 ProgressColor="{StaticResource Primary}"
                                 BackgroundColor="{StaticResource CardBackground}"
                                 HeightRequest="6">
                        <ProgressBar.Triggers>
                            <DataTrigger TargetType="ProgressBar"
                                         Binding="{Binding IsDeckProgressComplete}"
                                         Value="True">
                                <Setter Property="ProgressColor" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </ProgressBar.Triggers>
                    </ProgressBar>
                </VerticalStackLayout>

                <!-- Validation chip -->
                <Button Grid.Column="2"
                        Text="{x:Static constants:UserMessages.ValidationDetailsButton}"
                        Command="{Binding ShowValidationDetailsCommand}"
                        IsVisible="{Binding ShowValidationDetailsEntry}"
                        BackgroundColor="{StaticResource CardBackground}"
                        TextColor="#FFB74D"
                        FontSize="12"
                        Padding="10,6"
                        CornerRadius="10"
                        VerticalOptions="Center">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FASolid"
                                         Glyph="{x:Static fa:Solid.TriangleExclamation}"
                                         Size="12"
                                         Color="#FFB74D" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <!-- Row 1: Two tabs — Cards / Insights -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              BackgroundColor="{StaticResource Surface}"
              HeightRequest="48"
              ColumnSpacing="0">
            <Border Grid.Column="0" StrokeThickness="0" Padding="4,6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectCardsCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label FontFamily="FASolid" Text="{x:Static fa:Solid.List}" FontSize="13" TextColor="{Binding Tab0Color}" VerticalOptions="Center" />
                        <Label Text="Cards" FontSize="13" FontAttributes="{Binding Tab0Font}" TextColor="{Binding Tab0Color}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="2" Color="{Binding Tab0Color}" Opacity="{Binding Tab0Indicator}" HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" StrokeThickness="0" Padding="4,6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectInsightsCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label FontFamily="FASolid" Text="{x:Static fa:Solid.ChartColumn}" FontSize="13" TextColor="{Binding Tab1Color}" VerticalOptions="Center" />
                        <Label Text="Insights" FontSize="13" FontAttributes="{Binding Tab1Font}" TextColor="{Binding Tab1Color}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="2" Color="{Binding Tab1Color}" Opacity="{Binding Tab1Indicator}" HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Row 2: Bulk edit toolbar (selection mode) -->
        <Border Grid.Row="2"
                Padding="8,6"
                BackgroundColor="{StaticResource Surface}"
                StrokeThickness="0"
                IsVisible="{Binding IsSelectionMode}">
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="6"
                                       VerticalOptions="Center">
                    <Label Text="{Binding BulkSelectionCountText}"
                           FontSize="12"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center"
                           Margin="0,0,4,0"
                           MinimumWidthRequest="72" />
                    <Button Command="{Binding SelectAllInCurrentSectionCommand}"
                            Text="{OnIdiom Phone='', Default='All'}"
                            Padding="10,6"
                            FontSize="12"
                            BackgroundColor="{StaticResource CardBackground}"
                            TextColor="{StaticResource TextPrimary}"
                            SemanticProperties.Description="Select all">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FASolid"
                                             Glyph="{x:Static fa:Solid.CheckDouble}"
                                             Size="12"
                                             Color="{StaticResource TextPrimary}" />
                        </Button.ImageSource>
                    </Button>
                    <Button Command="{Binding ClearDeckSelectionCommand}"
                            Text="{OnIdiom Phone='', Default='None'}"
                            Padding="10,6"
                            FontSize="12"
                            BackgroundColor="{StaticResource CardBackground}"
                            TextColor="{StaticResource TextPrimary}"
                            SemanticProperties.Description="Clear selection">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FASolid"
                                             Glyph="{x:Static fa:Solid.Eraser}"
                                             Size="12"
                                             Color="{StaticResource TextPrimary}" />
                        </Button.ImageSource>
                    </Button>
                    <Button Command="{Binding BulkDecrementSelectionCommand}"
                            Text="{OnIdiom Phone='', Default='-1'}"
                            Padding="10,6"
                            FontSize="12"
                            BackgroundColor="{StaticResource CardBackground}"
                            TextColor="{StaticResource TextPrimary}"
                            SemanticProperties.Description="Decrease selected by 1">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FASolid"
                                             Glyph="{x:Static fa:Solid.Minus}"
                                             Size="12"
                                             Color="{StaticResource TextPrimary}" />
                        </Button.ImageSource>
                    </Button>
                    <Button Command="{Binding BulkIncrementSelectionCommand}"
                            Text="{OnIdiom Phone='', Default='+1'}"
                            Padding="10,6"
                            FontSize="12"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="Black"
                            SemanticProperties.Description="Increase selected by 1">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FASolid"
                                             Glyph="{x:Static fa:Solid.Plus}"
                                             Size="12"
                                             Color="Black" />
                        </Button.ImageSource>
                    </Button>
                    <Button Text="{OnIdiom Phone='Main', Default='To Main'}"
                            Command="{Binding BulkMoveSelectionToMainCommand}"
                            Padding="10,6"
                            FontSize="12"
                            BackgroundColor="{StaticResource CardBackground}"
                            TextColor="{StaticResource TextPrimary}" />
                    <Button Text="{OnIdiom Phone='Side', Default='To Side'}"
                            Command="{Binding BulkMoveSelectionToSideboardCommand}"
                            Padding="10,6"
                            FontSize="12"
                            BackgroundColor="{StaticResource CardBackground}"
                            TextColor="{StaticResource TextPrimary}" />
                    <Button Command="{Binding BulkRemoveSelectionCommand}"
                            Text="{OnIdiom Phone='', Default='Remove'}"
                            Padding="10,6"
                            FontSize="12"
                            BackgroundColor="#B00020"
                            TextColor="White"
                            SemanticProperties.Description="Remove selected">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FASolid"
                                             Glyph="{x:Static fa:Solid.TrashCan}"
                                             Size="12"
                                             Color="White" />
                        </Button.ImageSource>
                    </Button>
                    <Button Command="{Binding ToggleSelectionModeCommand}"
                            Text="{OnIdiom Phone='', Default='Done'}"
                            Padding="10,6"
                            FontSize="12"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            SemanticProperties.Description="Exit selection mode">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FASolid"
                                             Glyph="{x:Static fa:Solid.Check}"
                                             Size="12"
                                             Color="White" />
                        </Button.ImageSource>
                    </Button>
                </HorizontalStackLayout>
            </ScrollView>
        </Border>

        <!-- Row 3: Tab content + floating add button -->
        <Grid Grid.Row="3"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">
            <views:DeckCardsTabView VerticalOptions="Fill"
                                    HorizontalOptions="Fill"
                                    IsVisible="{Binding IsCardsTab}" />
            <views:DeckStatsTabView VerticalOptions="Fill"
                                    HorizontalOptions="Fill"
                                    IsVisible="{Binding IsInsightsTab}" />

            <!-- Icon FAB: fixed 52×52, no stroke (avoids dark ring on some platforms), light shadow only. -->
            <Border HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,16,16"
                    WidthRequest="52"
                    HeightRequest="52"
                    ZIndex="100"
                    StrokeShape="RoundRectangle 26"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource Accent}"
                    Shadow="{Shadow Brush=Black, Offset='0,2', Radius=8, Opacity=0.22}"
                    IsVisible="{Binding IsCardsTab}">
                <Button Clicked="OnAddCardsClicked"
                        BackgroundColor="Transparent"
                        Padding="0"
                        WidthRequest="52"
                        HeightRequest="52"
                        CornerRadius="26"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        SemanticProperties.Description="{x:Static constants:UserMessages.DeckDetailFabAddCards}"
                        SemanticProperties.Hint="Search and add cards to this deck">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FASolid"
                                         Glyph="{x:Static fa:Solid.Plus}"
                                         Size="22"
                                         Color="Black" />
                    </Button.ImageSource>
                </Button>
            </Border>
        </Grid>

        <!-- Row 4: Status strip (errors / transient edit feedback only) -->
        <Border Grid.Row="4"
                Padding="12,8"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource CardBackground}"
                StrokeThickness="1"
                IsVisible="{Binding ShowDeckDetailStatusRow}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="{Binding StatusDisplayText}"
                       FontSize="12"
                       TextColor="{Binding StatusTextColor}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="{x:Static constants:UserMessages.ValidationDetailsButton}"
                        Command="{Binding ShowValidationDetailsCommand}"
                        IsVisible="{Binding ShowValidationDetailsEntry}"
                        BackgroundColor="{StaticResource CardBackground}"
                        TextColor="{StaticResource TextPrimary}"
                        FontSize="12"
                        Padding="12,6"
                        CornerRadius="8"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>
