<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:controls="clr-namespace:AetherVault.Controls"
             xmlns:vm="clr-namespace:AetherVault.ViewModels"
             xmlns:pages="clr-namespace:AetherVault.Pages"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:constants="clr-namespace:AetherVault.Constants"
             xmlns:deckbrowse="clr-namespace:AetherVault.Services.DeckBuilder;assembly=AetherVault"
             x:Class="AetherVault.Pages.DeckAddCardsPage"
             x:DataType="vm:DeckAddCardsViewModel"
             Title="Add cards"
             BackgroundColor="{StaticResource Background}">

    <!-- Search + one chips row (suggestions / strategy / themes / lists) + grid + bottom staging dock. -->
    <Grid x:Name="PageRootGrid"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="0">

        <!-- Top: search dominates; chips bring suggestions and browsing inline (no buried popup). -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Surface}"
                StrokeThickness="0"
                Padding="12,8,12,10">
            <VerticalStackLayout Spacing="8">

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10"
                      VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Text="Done"
                            Clicked="OnDoneClicked"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            Padding="8,4"
                            MinimumWidthRequest="56"
                            VerticalOptions="Center" />
                    <material:TextField Grid.Column="1"
                                        Title="Search"
                                        Text="{Binding AddCardSearchText, Mode=TwoWay}"
                                        ReturnCommand="{Binding AddCardSearchCommand}"
                                        BackgroundColor="{StaticResource CardBackground}"
                                        TextColor="{StaticResource TextPrimary}"
                                        TitleColor="{StaticResource TextSecondary}"
                                        AccentColor="{StaticResource Primary}"
                                        AllowClear="True"
                                        VerticalOptions="Center" />
                    <ActivityIndicator Grid.Column="2"
                                       IsRunning="{Binding IsAnyAddCardWorkBusy}"
                                       IsVisible="{Binding IsAnyAddCardWorkBusy}"
                                       HeightRequest="22"
                                       WidthRequest="22"
                                       VerticalOptions="Center"
                                       Color="{StaticResource Primary}" />
                </Grid>

                <!-- One chips row: suggestions + strategy + deck themes + popular lists. -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            HeightRequest="44">
                    <HorizontalStackLayout Spacing="8"
                                           VerticalOptions="Center">
                        <Button Text="{x:Static constants:UserMessages.DeckAddSuggestionsChip}"
                                Command="{Binding LoadDeckSuggestionsCommand}"
                                IsVisible="{Binding ShowDeckSuggestionUi}"
                                FontSize="11"
                                FontAttributes="Bold"
                                Padding="12,8"
                                CornerRadius="16"
                                BackgroundColor="{StaticResource Accent}"
                                TextColor="Black">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FASolid"
                                                 Glyph="{x:Static fa:Solid.WandMagicSparkles}"
                                                 Size="11"
                                                 Color="Black" />
                            </Button.ImageSource>
                        </Button>
                        <Button Text="{Binding StrategyChipText}"
                                Clicked="OnStrategyChipClicked"
                                IsVisible="{Binding ShowDeckSuggestionUi}"
                                FontSize="11"
                                Padding="12,8"
                                CornerRadius="16"
                                BackgroundColor="{StaticResource CardBackground}"
                                TextColor="{StaticResource TextPrimary}" />
                        <HorizontalStackLayout Spacing="8"
                                               VerticalOptions="Center"
                                               BindableLayout.ItemsSource="{Binding AddCardSynergyPresetChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeckSynergyChipItem">
                                    <Button Text="{Binding DisplayText}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type pages:DeckAddCardsPage}}, Path=BindingContext.ApplyAddCardSynergyPresetCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="11"
                                            Padding="12,8"
                                            CornerRadius="16"
                                            BackgroundColor="{StaticResource CardBackground}"
                                            TextColor="{StaticResource TextPrimary}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8"
                                               VerticalOptions="Center"
                                               BindableLayout.ItemsSource="{Binding QuickBrowseListChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="deckbrowse:DeckBrowseListChipItem">
                                    <Button Text="{Binding DisplayText}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type pages:DeckAddCardsPage}}, Path=BindingContext.ApplyQuickBrowseListCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="11"
                                            Padding="12,8"
                                            CornerRadius="16"
                                            BackgroundColor="{StaticResource CardBackground}"
                                            TextColor="{StaticResource TextPrimary}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </ScrollView>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10"
                      VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="8"
                                           VerticalOptions="Center">
                        <Label Text="Collection only"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                        <Switch IsToggled="{Binding AddCardSearchOnlyCollection, Mode=TwoWay}"
                                OnColor="{StaticResource Primary}"
                                VerticalOptions="Center"
                                Scale="0.92" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1"
                           Text="{x:Static constants:UserMessages.DeckAddHintCommander}"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsAddModalCommanderFlow}" />
                </Grid>

                <!-- Active structured filter (theme or curated list) -->
                <Border Stroke="{StaticResource Accent}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource CardBackground}"
                        Padding="10,8"
                        IsVisible="{Binding HasAddCardStructuredFilter}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          VerticalOptions="Center">
                        <Label Text="{Binding AddCardStructuredFilterCaption}"
                               FontSize="12"
                               TextColor="{StaticResource Accent}"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                        <Button Grid.Column="1"
                                Text="{x:Static constants:UserMessages.DeckAddClearThemeFilter}"
                                Command="{Binding ClearAddCardSynergyPresetCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Accent}"
                                FontSize="12"
                                Padding="8,4"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Suggestion results caption -->
                <Label Text="{x:Static constants:UserMessages.DeckAddSuggestionsCaption}"
                       FontSize="11"
                       TextColor="{StaticResource Accent}"
                       LineBreakMode="WordWrap"
                       IsVisible="{Binding AddCardResultsAreSuggestions}" />
            </VerticalStackLayout>
        </Border>

        <!-- Results: full width, no nested card frame — maximum room for art. -->
        <Grid Grid.Row="1"
              Padding="8,4,8,0"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">
            <controls:CardGrid x:Name="AddResultsCardGrid"
                               IsVisible="{Binding IsAddCardResultsEmpty, Converter={StaticResource InvertedBool}}"
                               VerticalOptions="Fill"
                               HorizontalOptions="Fill" />
            <Label Text="{x:Static constants:UserMessages.DeckAddResultsEmpty}"
                   FontSize="13"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   Margin="24"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding IsAddCardResultsEmpty}" />
        </Grid>

        <!-- Bottom: targets + commit only when staging applies; commander flow gets its hint up top. -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource CardBackground}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16,16,0,0"
                Padding="14,12,14,14"
                Margin="0,6,0,0"
                IsVisible="{Binding IsStagedAddActive}">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,*,*"
                      ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="{x:Static constants:UserMessages.DeckAddTargetPickerTitle}"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="{x:Static constants:UserMessages.DeckAddTargetMainShort}"
                            Command="{Binding SetAddModalTargetMainCommand}"
                            FontSize="13"
                            Padding="12,10"
                            CornerRadius="10"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="{StaticResource CardBackground}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsAddModalTargetMain}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="Black" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2"
                            Text="{x:Static constants:UserMessages.DeckAddTargetSideboardShort}"
                            Command="{Binding SetAddModalTargetSideboardCommand}"
                            FontSize="13"
                            Padding="12,10"
                            CornerRadius="10"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="{StaticResource CardBackground}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsAddModalTargetSideboard}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="Black" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <Label Text="{Binding StagedAddSummaryText}"
                       FontSize="13"
                       TextColor="{StaticResource TextPrimary}"
                       FontAttributes="Bold"
                       LineBreakMode="WordWrap" />

                <uranium:ExpanderView IsExpanded="False"
                                      IsVisible="{Binding HasStagedAddItems}">
                    <uranium:ExpanderView.Header>
                        <Label Text="{x:Static constants:UserMessages.DeckAddStagingReviewTitle}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                    </uranium:ExpanderView.Header>
                    <CollectionView ItemsSource="{Binding StagedAddItems}"
                                    SelectionMode="None"
                                    MaximumHeightRequest="200"
                                    Margin="0,4,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StagedDeckAddItem">
                                <Grid Padding="0,6"
                                      ColumnDefinitions="*,Auto,Auto,Auto"
                                      ColumnSpacing="10"
                                      VerticalOptions="Center">
                                    <Label Grid.Column="0"
                                           Text="{Binding Card.Name}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="14"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Text="−"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type pages:DeckAddCardsPage}}, Path=BindingContext.DecrementStagedAddQuantityCommand}"
                                            CommandParameter="{Binding .}"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Padding="0"
                                            FontSize="18"
                                            BackgroundColor="{StaticResource CardBackground}"
                                            TextColor="{StaticResource TextPrimary}"
                                            CornerRadius="10" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Quantity}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center"
                                           WidthRequest="28"
                                           HorizontalTextAlignment="Center" />
                                    <Button Grid.Column="3"
                                            Text="+"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type pages:DeckAddCardsPage}}, Path=BindingContext.IncrementStagedAddQuantityCommand}"
                                            CommandParameter="{Binding .}"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Padding="0"
                                            FontSize="18"
                                            BackgroundColor="{StaticResource Accent}"
                                            TextColor="Black"
                                            CornerRadius="10" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </uranium:ExpanderView>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="{Binding AddStagedCardsToDeckButtonText}"
                            Command="{Binding AddStagedCardsToDeckCommand}"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="Black"
                            CornerRadius="12"
                            Padding="16,14"
                            FontAttributes="Bold" />
                    <Button Grid.Column="1"
                            Text="Clear"
                            Command="{Binding ClearStagedAddsCommand}"
                            BackgroundColor="{StaticResource CardBackground}"
                            TextColor="{StaticResource TextPrimary}"
                            CornerRadius="12"
                            Padding="16,14" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
