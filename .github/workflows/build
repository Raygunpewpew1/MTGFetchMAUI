name: Build Android APK

on:
  workflow_dispatch:      # lets you trigger it manually from the GitHub UI/app
  push:
    branches: [ main ]    # remove or adjust if you don't want it on every push

jobs:
  build:
    runs-on: windows-latest   # windows-latest has the most reliable MAUI workload support

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Install MAUI Android workload
        run: dotnet workload install maui-android

      - name: Restore dependencies
        run: dotnet restore

      # Adjust the csproj path/name below to match your actual project file
      - name: Build Android APK (Debug)
        run: >
          dotnet build "AetherVault/AetherVault.csproj"
          -f net10.0-android
          -c Debug
          -o build-output

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: AetherVault-apk
          path: build-output/*.apk